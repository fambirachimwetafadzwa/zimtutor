# ─────────────────────────────────────────────────────────────────────────────
# ZimTutor environment. Copy to `.env.local` (Next.js) and fill in.
# NEVER commit real values. Variables prefixed NEXT_PUBLIC_ are sent to browsers.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Postgres + Auth + Storage + pgvector) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Either the legacy "anon" key or the newer "publishable" key works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Bypasses row-level security: used for marking, mastery writes and
# parent-created learner accounts. Never import into client code.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# Direct Postgres connection used ONLY by the offline CLIs (db:migrate, curriculum:load,
# curriculum:embed). Not needed by the running web app.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── AI provider abstraction ──────────────────────────────────────────────────
# anthropic | openai-compatible | mock   (mock = deterministic offline provider, no network)
# The tutor works with NO model at all: when a model is unavailable or its reply fails a check, the
# plain template text is shown instead. A model only phrases facts the application supplies.
AI_PROVIDER=mock
# The model name is always configured here, never chosen in code (required for anthropic and openai-compatible).
AI_MODEL=
# Optional, anthropic only: how hard the model thinks (low | medium | high | xhigh | max).
AI_EFFORT=
ANTHROPIC_API_KEY=
# For openai-compatible: any server speaking POST {base}/chat/completions
# (OpenAI, Azure, OpenRouter, vLLM, Ollama...).
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# ── Child safety ─────────────────────────────────────────────────────────────
# Named in the reply a child gets when they write something worrying. The default is Childline
# Zimbabwe, 116: CONFIRM THE NUMBER BEFORE LAUNCH (a wrong number is worse than none). Set the
# number to "none" to name no helpline.
CHILD_HELPLINE_NAME=Childline
CHILD_HELPLINE_NUMBER=116

# ── Embeddings (RAG) ─────────────────────────────────────────────────────────
# openai-compatible | local-hash   (local-hash = deterministic offline fallback)
EMBEDDING_PROVIDER=local-hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# ── Monitoring / analytics (both optional; both OFF when unset) ──────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Limits on trying ─────────────────────────────────────────────────────────
# Sign-in guesses, accounts made, lesson questions and practice papers are counted in the database
# (hashed: nothing that names a child or a family is kept). All optional.
#
# The key counters are hashed with (at least 16 characters). Empty: a key made from the service key.
RATE_LIMIT_SECRET=
# The header your hosting puts the visitor's internet address in (for example x-real-ip or
# cf-connecting-ip), used to limit failed sign-ins and sign-ups from one place. Empty: on Vercel,
# x-forwarded-for is used (Vercel sets it itself); anywhere else NO limit by address is applied,
# because any other header can be sent by a visitor. Limits by account always apply.
CLIENT_IP_HEADER=

# ── Monitoring (off unless set) ──────────────────────────────────────────────
# Nothing is reported anywhere by default. Reports are scrubbed first and never name a child, a
# parent or a lesson's words (see src/lib/monitoring).
#
# Errors, to Sentry (https://<key>@<host>/<project>). Environment and release are optional.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Anonymous counts (lessons finished, limits reached...), to PostHog. Both are needed; the host is
# named, not guessed, so that where the counts go is always somebody's decision.
POSTHOG_KEY=
POSTHOG_HOST=
